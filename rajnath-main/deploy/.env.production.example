# Production settings. deploy/install.sh fills DOMAIN, APP_URL, APP_KEY and the passwords for you.
# Keep this file private (chmod 600) and keep a copy of APP_KEY: it encrypts the keys and passwords
# you save in the admin. Payment, email, SMS, push, courier, payout, calling and AI keys are NOT set
# here — enter them in the admin after signing in (they are stored encrypted).

# ---- Website address ----
DOMAIN=astrorajnathjha.com
APP_URL=https://astrorajnathjha.com
# In-app calls: set to rtc.<your domain> (with a DNS record) when LIVEKIT_API_KEY is set below.
RTC_DOMAIN=rtc.localhost

# ---- Application ----
APP_NAME="Astro Rajnath Jha"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXIES=*

# ---- Database (the db container uses the same values) ----
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=arj
DB_USERNAME=arj
DB_PASSWORD=change-me-long-random
MARIADB_PASSWORD=change-me-long-random
MARIADB_ROOT_PASSWORD=change-me-other-long-random

# ---- Cache, queue, sessions ----
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
# Session data is encrypted with APP_KEY before it is stored in Redis. Turning this on for an
# existing site signs everyone out once.
SESSION_ENCRYPT=true
REDIS_HOST=redis

# Fallback only; the real mail server is set in Admin › Email & SMS.
MAIL_MAILER=log

# ---- Built into the Docker image (leave as is) ----
ARJ_EPHEM_BIN=/var/www/engine/bin/arj-ephem
ARJ_EPHE_PATH=/var/www/engine/ephe
PDF_CHROME_BINARY=/usr/bin/chromium

# Website/app languages shown to visitors (English is the default). The owner can change this in
# Admin › Languages; text is translated with the AI key from Admin › AI assistant.
SITE_LOCALES=en,hi,bn,mr,te,ta,gu,ur,kn

# ---- First admin (created automatically by deploy/deploy.sh when there is no admin yet) ----
# install.sh fills the email and name. Leave ADMIN_PASSWORD empty to get a random password printed
# once at the end of the deploy (recommended); change it after signing in (Admin › My account).
ADMIN_EMAIL=
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=
ARJ_ALLOW_PRIVATE_PROVIDER_HOSTS=false

# ---- In-app calls (optional): LiveKit server on this VPS (docs/ops/livekit-on-vps.md) ----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_VERSION=v1.9.0
